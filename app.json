{
  "expo": {
    "name": "Youthcamp",
    "slug": "youthcamp_mobile_client",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFC40C"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#FFC40C"
      },
      "package": "com.youthcamp.mobile_client",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["CAMERA"]
    },
    "androidStatusBar": {
      "backgroundColor": "#000000"
    },
    "extra": {
      "eas": {
        "projectId": "6f46ae9e-a6ac-4363-b2cb-037345f7a181"
      }
    }
  }
}
