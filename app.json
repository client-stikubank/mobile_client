{
  "expo": {
    "name": "Youthcamp",
    "slug": "youthcamp_mobile_client",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ]
    ],
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFC438"
    },
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.youthcamp",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes on event tickets, redeem gifts, and attendance camp."
      },
      "buildNumber": "1"
    },
    "android": {
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#FFC438"
      },
      "package": "com.youthcamp.mobile_client",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["CAMERA"]
    },
    "androidStatusBar": {
      "backgroundColor": "#FFC438",
      "translucent": false
    },
    "extra": {
      "eas": {
        "projectId": "6f46ae9e-a6ac-4363-b2cb-037345f7a181"
      }
    }
  }
}
